import game::{Entity, Vec2, World};

// `update` is the script-side system. The C++ demo registers `game::Entity`,
// `game::Vec2`, and the global `World` effect, then typechecks this file.
function update() {
    Entity player = World::player();
    Entity enemy = World::enemy();

    Vec2 offset = enemy.position() - player.position();
    float distance = offset.length();

    if (distance < 2.0f) {
        enemy.damage(15.0f);
        println(`hit ${enemy.name()} at distance ${distance}`);
    }

    if (!enemy.is_alive()) {
        despawn(enemy);
        println("enemy defeated");
    }

    player.move(1.0f, 0.0f);
}
